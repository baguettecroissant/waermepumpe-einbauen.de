---
import { siteConfig } from '../../site.config';

interface Props {
  keyword?: string;
  defaultZip?: string;
}

const { keyword = siteConfig.niche.name, defaultZip = '' } = Astro.props;
---

<div class="bg-white rounded-2xl border border-gray-200 shadow-xl overflow-hidden" id="devis-form">
  <!-- Widget Header -->
  <div class="bg-brand-700 p-5 text-white text-center border-b border-gray-100">
    <h3 class="font-bold text-lg font-heading flex items-center justify-center gap-2">
      🔧 Wärmepumpen-Fachbetriebe
    </h3>
    <p class="text-xs text-brand-100 mt-1 font-heading">
      Finden Sie geprüfte Heizungsbauer aus Ihrer Region
    </p>
  </div>

  <!-- Multi-step Form Container -->
  <div class="p-6 bg-[#FAFAFA] min-h-[385px] flex flex-col justify-between" id="solar-form-wizard">
    
    <!-- Step 1: Eigentum -->
    <div class="step-pane active" data-step="1">
      <p class="text-xs font-semibold text-accent-500 uppercase tracking-wider mb-2 font-heading">Schritt 1 von 6</p>
      <h4 class="font-bold text-base text-gray-900 mb-4 font-heading">Sind Sie Eigentümer des Hauses?</h4>
      <div class="space-y-3">
        <button type="button" class="form-btn font-heading" data-next="true" data-detail-key="eigentumsverhaeltnisse" data-detail-value="Eigner / Entscheidungsbefugt">Ja, ich bin Eigentümer</button>
        <button type="button" class="form-btn font-heading" data-disqualify="owner">Nein, ich bin Mieter</button>
      </div>
    </div>

    <!-- Step 2: Art der Immobilie -->
    <div class="step-pane hidden" data-step="2">
      <p class="text-xs font-semibold text-accent-500 uppercase tracking-wider mb-2 font-heading">Schritt 2 von 6</p>
      <h4 class="font-bold text-base text-gray-900 mb-4 font-heading">Um welche Art von Gebäude handelt es sich?</h4>
      <div class="space-y-3">
        <button type="button" class="form-btn font-heading" data-next="true" data-detail-key="objekt" data-detail-value="Einfamilienhaus">Einfamilienhaus</button>
        <button type="button" class="form-btn font-heading" data-next="true" data-detail-key="objekt" data-detail-value="Zweifamilienhaus">Zweifamilienhaus</button>
        <button type="button" class="form-btn font-heading" data-disqualify="property">Mehrfamilienhaus</button>
        <button type="button" class="form-btn font-heading" data-disqualify="property">Gewerbeobjekt</button>
      </div>
    </div>

    <!-- Step 3: Beheizte Wohnfläche -->
    <div class="step-pane hidden" data-step="3">
      <p class="text-xs font-semibold text-accent-500 uppercase tracking-wider mb-2 font-heading">Schritt 3 von 6</p>
      <h4 class="font-bold text-base text-gray-900 mb-4 font-heading">Wie groß ist die beheizte Wohnfläche?</h4>
      <div class="space-y-3">
        <button type="button" class="form-btn font-heading" data-disqualify="size">Unter 80 m²</button>
        <button type="button" class="form-btn font-heading" data-next="true">80 m² bis 250 m²</button>
        <button type="button" class="form-btn font-heading" data-disqualify="size">Über 250 m²</button>
      </div>
    </div>

    <!-- Step 4: Wärmepumpen-Typ -->
    <div class="step-pane hidden" data-step="4">
      <p class="text-xs font-semibold text-accent-500 uppercase tracking-wider mb-2 font-heading">Schritt 4 von 6</p>
      <h4 class="font-bold text-base text-gray-900 mb-4 font-heading">Welchen Wärmepumpen-Typ wünschen Sie?</h4>
      <div class="space-y-3">
        <button type="button" class="form-btn font-heading" data-next="true" data-detail-key="heat_pump_type" data-detail-value="Luft-Wasser-Wärmepumpe">Luft-Wasser-Wärmepumpe</button>
        <button type="button" class="form-btn font-heading" data-disqualify="type">Sole-Wasser-Wärmepumpe (Erdwärme)</button>
        <button type="button" class="form-btn font-heading" data-disqualify="type">Wasser-Wasser-Wärmepumpe (Grundwasser)</button>
        <button type="button" class="form-btn font-heading" data-disqualify="type">Luft-Luft-Wärmepumpe</button>
      </div>
    </div>

    <!-- Step 5: Aufstellungsort -->
    <div class="step-pane hidden" data-step="5">
      <p class="text-xs font-semibold text-accent-500 uppercase tracking-wider mb-2 font-heading">Schritt 5 von 6</p>
      <h4 class="font-bold text-base text-gray-900 mb-4 font-heading">Wo soll die Wärmepumpe aufgestellt werden?</h4>
      <div class="space-y-3">
        <button type="button" class="form-btn font-heading" data-next="true" data-detail-key="heating_room_location" data-detail-value="Keller">Keller</button>
        <button type="button" class="form-btn font-heading" data-next="true" data-detail-key="heating_room_location" data-detail-value="Wohnraum">Wohnraum</button>
        <button type="button" class="form-btn font-heading" data-next="true" data-detail-key="heating_room_location" data-detail-value="Hauswirtschaftsraum">Hauswirtschaftsraum</button>
        <button type="button" class="form-btn font-heading" data-next="true" data-detail-key="heating_room_location" data-detail-value="Anderer Standort">Anderer Standort</button>
        <button type="button" class="form-btn font-heading" data-disqualify="roof">Dachgeschoss</button>
      </div>
    </div>

    <!-- Step 6: Zeitplan -->
    <div class="step-pane hidden" data-step="6">
      <p class="text-xs font-semibold text-accent-500 uppercase tracking-wider mb-2 font-heading">Schritt 6 von 6</p>
      <h4 class="font-bold text-base text-gray-900 mb-4 font-heading">Wann soll der Einbau erfolgen?</h4>
      <div class="space-y-3">
        <button type="button" class="form-btn font-heading" data-next="true" data-detail-key="zeitpunkt_projektbegin" data-detail-value="Umgehend">Umgehend</button>
        <button type="button" class="form-btn font-heading" data-next="true" data-detail-key="zeitpunkt_projektbegin" data-detail-value="In den nächsten 3 Monaten">In den nächsten 3 Monaten</button>
        <button type="button" class="form-btn font-heading" data-next="true" data-detail-key="zeitpunkt_projektbegin" data-detail-value="In 3 bis 6 Monaten">In 3 bis 6 Monaten</button>
        <button type="button" class="form-btn font-heading" data-disqualify="timing">Später</button>
      </div>
    </div>

    <!-- Step 7: Kontaktdaten (Qualified) -->
    <div class="step-pane hidden" data-step="7">
      <p class="text-xs font-semibold text-accent-500 uppercase tracking-wider mb-2 font-heading">Letzter Schritt</p>
      <h4 class="font-bold text-base text-gray-900 mb-4 font-heading">Angebote kostenlos anfordern</h4>
      
      <form id="solar-lead-form" class="space-y-3">
        <div>
          <label class="block text-xs font-bold text-gray-600 mb-1 font-heading">Postleitzahl</label>
          <input type="text" name="zip" required pattern="[0-9]{5}" placeholder="z.B. 10115" value={defaultZip} class="form-input font-data" />
        </div>
        <div class="grid grid-cols-2 gap-2">
          <div>
            <label class="block text-xs font-bold text-gray-600 mb-1 font-heading">Vorname</label>
            <input type="text" name="firstname" required placeholder="Vorname" class="form-input font-heading" />
          </div>
          <div>
            <label class="block text-xs font-bold text-gray-600 mb-1 font-heading">Nachname</label>
            <input type="text" name="lastname" required placeholder="Nachname" class="form-input font-heading" />
          </div>
        </div>
        <div>
          <label class="block text-xs font-bold text-gray-600 mb-1 font-heading">E-Mail-Adresse</label>
          <input type="email" name="email" required placeholder="name@beispiel.de" class="form-input font-heading" />
        </div>
        <div>
          <label class="block text-xs font-bold text-gray-600 mb-1 font-heading">Telefonnummer</label>
          <input type="tel" name="phone" required placeholder="z.B. 0170 1234567" class="form-input font-data" />
        </div>
        <input type="text" name="website" tabindex="-1" autocomplete="off" aria-hidden="true" style="position:absolute;left:-9999px;width:1px;height:1px;overflow:hidden;" />
        <div>
          <label class="block text-xs font-bold text-gray-600 mb-1">Straße und Hausnummer</label>
          <input type="text" name="street" required maxlength="200" autocomplete="street-address" placeholder="Musterstraße 12" class="form-input" />
        </div>
        <div class="grid grid-cols-2 gap-2">
          <div>
            <label class="block text-xs font-bold text-gray-600 mb-1">Ort</label>
            <input type="text" name="city" required maxlength="120" autocomplete="address-level2" placeholder="Ort" class="form-input" />
          </div>
          <div>
            <label class="block text-xs font-bold text-gray-600 mb-1">Wohnfläche (m²)</label>
            <input type="number" name="heizflaeche" required min="80" max="250" step="1" inputmode="numeric" class="form-input" />
          </div>
        </div>
        <label class="flex items-start gap-2 text-[10px] text-gray-600 leading-snug mt-2">
          <input type="checkbox" name="consent" required class="mt-0.5" />
          <span>Ich willige ein, dass meine Angaben zur Bearbeitung meiner Angebotsanfrage an <strong>TapTapHome (DAA GmbH)</strong> übermittelt werden. Ich habe die <a href="/datenschutz" class="underline" target="_blank" rel="noopener noreferrer">Datenschutzhinweise</a> und die <a href="https://www.taptaphome.com/de/agb-nutzer" class="underline" target="_blank" rel="noopener noreferrer">AGB für Anfragesteller:innen</a> gelesen.</span>
        </label>

        <button type="submit" class="submit-btn mt-3 font-heading">
          🔧 Jetzt Fachbetrieb finden →
        </button>
      </form>
    </div>

    <!-- Disqualified State -->
    <div class="step-pane hidden text-center py-6" id="disqualify-pane">
      <span class="text-4xl block mb-3">⚠️</span>
      <h4 class="font-bold text-base text-gray-900 mb-2 font-heading">Einbau leider nicht vermittelbar</h4>
      <p class="text-xs text-gray-600 leading-relaxed max-w-sm mx-auto mb-4 font-heading" id="disqualify-msg">
        Leider entsprechen Ihre Angaben nicht den Kriterien unserer Partner-Betriebe.
      </p>
      <a href="/ratgeber" class="inline-block bg-gray-200 text-gray-700 font-bold px-4 py-2 rounded-xl text-xs hover:bg-gray-300 transition-colors font-heading">
        Zu den Einbau-Ratgebern
      </a>
    </div>

    <!-- Success State -->
    <div class="step-pane hidden text-center py-6" id="success-pane">
      <span class="text-4xl block mb-3">✅</span>
      <h4 class="font-bold text-base text-gray-900 mb-2 font-heading">Anfrage erfolgreich!</h4>
      <p class="text-xs text-gray-600 leading-relaxed max-w-sm mx-auto mb-4 font-heading">
        Vielen Dank. Ihre Daten wurden sicher übermittelt. Ein zertifizierter Heizungsfachmann aus der DAA-Gruppe wird sich in den nächsten 24 bis 48 Stunden telefonisch oder per E-Mail bei Ihnen melden.
      </p>
    </div>

    <!-- Footer buttons for going back -->
    <div class="flex items-center justify-between border-t border-gray-100 pt-4 mt-6 text-xs text-gray-500" id="form-nav-footer">
      <button type="button" id="prev-step-btn" class="hover:text-accent-500 font-semibold hidden cursor-pointer font-heading">← Zurück</button>
      <span class="ml-auto text-[10px] font-semibold text-gray-400 font-heading">100% Kostenlos & Unverbindlich</span>
    </div>
  </div>

  <!-- Trust block -->
  <div class="bg-gray-100/60 px-6 py-4 border-t border-gray-200 flex justify-around text-[10px] font-semibold text-gray-600">
    <span class="flex items-center gap-1 font-heading">🔒 SSL-Verschlüsselt</span>
    <span class="flex items-center gap-1 font-heading">⏱️ Dauer: 2 Min</span>
    <span class="flex items-center gap-1 font-heading">🔧 2-3 Tage Einbau</span>
  </div>
</div>

<style>
  .form-btn {
    display: block;
    width: 100%;
    padding: 0.75rem 1rem;
    text-align: left;
    background: #ffffff;
    border: 1px solid #e2e8f0;
    border-radius: 0.75rem;
    font-weight: 600;
    font-size: 0.875rem;
    color: #212121;
    transition: all 0.2s ease;
    cursor: pointer;
  }
  .form-btn:hover {
    border-color: #D84315;
    background: #FBE9E7;
    color: #D84315;
    transform: translateY(-1px);
    box-shadow: 0 4px 6px -1px rgba(216, 67, 21, 0.05);
  }
  .form-input {
    width: 100%;
    padding: 0.5rem 0.75rem;
    border: 1px solid #cbd5e1;
    border-radius: 0.5rem;
    font-size: 0.875rem;
    color: #212121;
    outline: none;
    transition: border-color 0.2s ease;
  }
  .form-input:focus {
    border-color: #D84315;
    box-shadow: 0 0 0 2px rgba(216, 67, 21, 0.1);
  }
  .submit-btn {
    width: 100%;
    background: linear-gradient(135deg, #D84315 0%, #FF5722 100%);
    color: #ffffff;
    font-weight: 700;
    font-size: 0.875rem;
    padding: 0.875rem;
    border-radius: 0.75rem;
    transition: all 0.2s ease;
    cursor: pointer;
    border: none;
  }
  .submit-btn:hover {
    background: linear-gradient(135deg, #BF360C 0%, #D84315 100%);
    transform: scale(1.02);
    box-shadow: 0 4px 12px rgba(216, 67, 21, 0.2);
  }
</style>

<script is:inline define:vars={{ siteConfig }}>
  (function() {
    const container = document.getElementById('solar-form-wizard');
    const form = document.getElementById('solar-lead-form');
    if (!container || !form) return;

    let currentStep = 1;
    const answers = {};
    const formStartedAt = new Date().toISOString();
    const idempotencyKey = (globalThis.crypto && crypto.randomUUID ? crypto.randomUUID() : 'xxxxxxxx-xxxx-4xxx-yxxx-xxxxxxxxxxxx'.replace(/[xy]/g, function(c) { var r = crypto.getRandomValues(new Uint8Array(1))[0] & 15; var v = c === 'x' ? r : (r & 3) | 8; return v.toString(16); }));
    const steps = container.querySelectorAll('.step-pane[data-step]');
    const prevBtn = document.getElementById('prev-step-btn');
    const footerNav = document.getElementById('form-nav-footer');
    const disqualifyPane = document.getElementById('disqualify-pane');
    const successPane = document.getElementById('success-pane');
    const disqualifyMsg = document.getElementById('disqualify-msg');
    const requiredAnswers = ["eigentumsverhaeltnisse", "objekt", "heat_pump_type", "heating_room_location", "zeitpunkt_projektbegin"];
    const disqualifyMessages = {
      owner: 'Unsere Partner-Fachbetriebe arbeiten ausschließlich mit Hauseigentümern zusammen.',
      property: 'Mehrfamilienhäuser und Gewerbeobjekte können über diesen Dienst nicht vermittelt werden.',
      size: 'Das Projekt liegt außerhalb der vermittelbaren Flächengrenzen.',
      type: 'Dieser Wärmepumpentyp wird über diesen Dienst nicht vermittelt.',
      roof: 'Dieser Aufstellungsort wird über diesen Dienst nicht vermittelt.',
      timing: 'Vermittelt werden nur Projekte, die innerhalb der nächsten sechs Monate beginnen.',
      asbestos: 'Dächer mit Schiefer oder Asbest können nicht vermittelt werden.',
      consumption: 'Für die Vermittlung ist ein jährlicher Stromverbrauch ab 1.500 kWh erforderlich.',
      unsupported: 'Diese Auswahl wird über diesen Dienst nicht vermittelt.'
    };

    function showStep(stepNum) {
      steps.forEach(function(step) {
        const active = Number(step.getAttribute('data-step')) === stepNum;
        step.classList.toggle('hidden', !active);
        step.classList.toggle('active', active);
      });
      currentStep = stepNum;
      if (prevBtn) prevBtn.classList.toggle('hidden', !(currentStep > 1 && currentStep <= 7));
    }

    container.addEventListener('click', function(event) {
      const btn = event.target.closest('button');
      if (!btn) return;
      const detailKey = btn.getAttribute('data-detail-key');
      const detailValue = btn.getAttribute('data-detail-value');
      if (detailKey && detailValue) answers[detailKey] = detailValue;
      if (btn.getAttribute('data-next') === 'true') {
        showStep(currentStep + 1);
      } else if (btn.getAttribute('data-disqualify')) {
        const reason = btn.getAttribute('data-disqualify');
        if (disqualifyMsg) disqualifyMsg.textContent = disqualifyMessages[reason] || disqualifyMessages.unsupported;
        steps.forEach(function(step) { step.classList.add('hidden'); });
        if (disqualifyPane) disqualifyPane.classList.remove('hidden');
        if (footerNav) footerNav.classList.add('hidden');
      }
    });

    if (prevBtn) prevBtn.addEventListener('click', function() { if (currentStep > 1) showStep(currentStep - 1); });

    form.addEventListener('submit', async function(event) {
      event.preventDefault();
      if (!form.reportValidity()) return;
      if (requiredAnswers.some(function(key) { return !answers[key]; })) {
        alert('Bitte beantworten Sie alle Projektfragen.');
        return;
      }
      const data = Object.fromEntries(new FormData(form).entries());
      const submitBtn = form.querySelector('.submit-btn');
      const originalText = submitBtn ? submitBtn.innerText : '';
      if (submitBtn) { submitBtn.disabled = true; submitBtn.innerText = 'Wird gesendet...'; }
      const jobDetails = Object.assign({}, answers);
      jobDetails.heizflaeche = Number(data.heizflaeche);
      const payload = {
        firstname: data.firstname,
        lastname: data.lastname,
        email: data.email,
        phone: data.phone,
        street: data.street,
        zip: data.zip,
        city: data.city,
        job_details: jobDetails,
        page_url: window.location.href,
        consent: form.querySelector('[name="consent"]').checked,
        consent_version: 'taptaphome-de-2026-08-12-v1',
        consent_at: new Date().toISOString(),
        form_started_at: formStartedAt,
        idempotency_key: idempotencyKey,
        website: data.website || ''
      };
      try {
        const response = await fetch('/api/lead', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify(payload) });
        const result = await response.json().catch(function() { return { success: false, errors: ['Ungültige Serverantwort.'] }; });
        if (!response.ok || result.success !== true) throw new Error(Array.isArray(result.errors) ? result.errors.join(', ') : 'Bitte versuchen Sie es erneut.');
        steps.forEach(function(step) { step.classList.add('hidden'); });
        if (successPane) successPane.classList.remove('hidden');
        if (footerNav) footerNav.classList.add('hidden');
      } catch (error) {
        alert('Fehler bei der Übermittlung: ' + (error instanceof Error ? error.message : 'Bitte versuchen Sie es erneut.'));
        if (submitBtn) { submitBtn.disabled = false; submitBtn.innerText = originalText; }
      }
    });
  })();
</script>
